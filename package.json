{
  "name": "pro-choice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.x",
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "format": "bunx --bun biome format --write .",
    "check": "bunx --bun biome check .",
    "lint:fast": "bunx --bun oxlint --deny-warnings src scripts",
    "lint": "bunx --bun eslint .",
    "typecheck": "bunx --bun next typegen && bunx --bun tsc --noEmit",
    "verify": "bun run check && bun run lint:fast && bun run lint && bun run typecheck && bun run build",
    "ingest": "bun run scripts/ingest/run.ts",
    "audit:lifecycle": "bun run scripts/ingest/audit-lifecycle.ts",
    "validate:snapshot": "bun run scripts/ingest/validate-snapshot.ts",
    "sync": "bun run scripts/ingest/sync.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "d3-scale": "^4.0.3",
    "hyparquet": "^1.33.1",
    "hyparquet-compressors": "^1.1.3",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "papaparse": "^5.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/config": "^0.15.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
